    given-names: "Kurt"
    # ORCID iD wird nachgetragen, sobald angelegt (orcid.org/register)
    # orcid: "https://orcid.org/0009-0004-3461-8666"
    affiliation: "ChronoGrid Systems"
repository-code: "https://github.com/kb2620-AT/chronogrid-impl"
url: "https://chronogrid.at/preview"
license: Apache-2.0
version: "0.9.0"
date-released: "2026-07-15"
keywords:
  - time-standardization
  - time-addressing
  - CGTA
  - ISO-TC-154
  - timestamp
  - BigInt
