{
  "name": "cg-api",
  "version": "1.0.0",
  "type": "module",
  "description": "ChronoGrid Registry API — REST-Gateway (CG-STD-4100 Kap. 4–8)",
  "exports": {
    ".":               { "import": "./src/index.ts" },
    "./handlers.js":   { "import": "./src/handlers.ts" },
    "./middleware.js":  { "import": "./src/middleware.ts" },
    "./openapi.js":    { "import": "./src/openapi.ts" }
  },
  "scripts": {
    "build": "tsc --build",
