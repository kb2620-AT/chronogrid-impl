    "cg-ctddl":   "workspace:*",
    "cg-engine":  "workspace:*",
    "cg-cguas":   "workspace:*",
    "cg-storage": "workspace:*"
  },
  "devDependencies": {
    "typescript":  "^5.4.0",
    "tsx":         "^4.7.0",
    "@types/node": "^20.0.0"
  }
}
