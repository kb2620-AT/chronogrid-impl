{
  "name": "chronogrid-refimpl",
  "version": "1.0.0",
  "private": true,
  "description": "ChronoGrid Reference Implementation — CG-APP-0700 v0.3",
  "scripts": {
    "build":        "tsc --build",
    "test":         "pnpm --filter cg-testkit run test",
    "test:level1":  "pnpm --filter cg-testkit run test:level1",
    "test:level2":  "pnpm --filter cg-testkit run test:level2",
    "test:level3":  "pnpm --filter cg-testkit run test:level3",
    "test:json":    "pnpm --filter cg-testkit run test:json",
    "report":       "pnpm --filter cg-testkit run report",
    "lint":         "eslint packages/*/src apps/*/src --ext .ts",
    "clean":        "find . -name dist -type d -not -path '*/node_modules/*' | xargs rm -rf"
  },
  "devDependencies": {
    "typescript":            "^5.4.0",
    "tsx":                   "^4.7.0",
    "@types/node":           "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser":        "^7.0.0",
    "eslint":                "^8.57.0"
  }
}
