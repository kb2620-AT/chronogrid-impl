{
  "compilerOptions": {
    "target":              "ES2022",
    "module":              "NodeNext",
    "moduleResolution":    "NodeNext",
    "lib":                 ["ES2022"],
    "strict":              true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop":     false,
    "skipLibCheck":        true,
    "declaration":         true,
    "declarationMap":      true,
    "sourceMap":           true,
    "outDir":              "./dist",
    "rootDir":             "./src"
  }
}
