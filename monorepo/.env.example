# ChronoGrid API – Umgebungsvariablen
# Kopieren nach .env und anpassen

# Storage-Backend: 'memory' (Tests) oder 'postgres' (Produktion)
STORAGE=memory

# PostgreSQL-Verbindung (nur wenn STORAGE=postgres)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=chronogrid
PG_USER=cg_user
PG_PASSWORD=cg_secret
PG_MAX_CONNECTIONS=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=2000

# API-Server
API_HOST=127.0.0.1
API_PORT=3000

# JWT-Konfiguration (Level 2+)
JWT_SECRET=change-me-in-production
JWT_ISSUER=chronogrid
JWT_AUDIENCE=cg-api

# Webhook-Signierung (Sprint 7)
WEBHOOK_SECRET=change-me-too
