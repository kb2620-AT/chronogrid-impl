# ============================================================================
# ChronoGrid — Environment Variables
# Kopiere diese Datei nach .env und passe die Werte an.
# NIEMALS .env in Git committen (bereits in .gitignore).
# ============================================================================

# Storage-Backend: "memory" (Standard/Tests) oder "postgres" (Produktion)
STORAGE=memory

# PostgreSQL-Verbindung (nur wenn STORAGE=postgres)
PGHOST=localhost
PGPORT=5432
PGDATABASE=chronogrid
PGUSER=chronogrid
PGPASSWORD=chronogrid_dev
PGSSL=false

# PostgreSQL Connection Pool
PG_POOL_MIN=2
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT_MS=30000

# API-Server
API_PORT=3000
API_HOST=0.0.0.0

# JWT (Produktion: echte RS256/ES256 Keys verwenden)
# Für lokale Entwicklung wird JWT-Validierung vereinfacht
JWT_ISSUER=https://auth.chronogrid.local
JWT_AUDIENCE=chronogrid-api

# Logging
LOG_LEVEL=info   # debug | info | warn | error
